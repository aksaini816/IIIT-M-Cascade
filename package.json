{
  "name": "kindora-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build:workspaces": "npm run build --workspaces --if-present",
    "test:workspaces": "npm test --workspaces --if-present",
    "setup:local": "npm install && docker compose up -d postgres && npm exec --workspace=apps/api prisma generate && npm exec --workspace=apps/api prisma db push && npm exec --workspace=apps/api prisma db seed",
    "start:api": "npm run dev --workspace=apps/api",
    "start:web": "npm run dev --workspace=apps/web",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.57.11"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
